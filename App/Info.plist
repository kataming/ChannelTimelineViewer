<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  共有シート（Share Extension）からメインアプリを開くためのカスタムURLスキーム。
	  Share Extension は channeltimelineviewer://share?url=<共有されたYouTubeURL> を開くだけで、
	  URL の解析・API 取得・画面遷移はメインアプリ側で行う。
	  ※ その他の Info.plist の値は GENERATE_INFOPLIST_FILE=YES（project.yml の INFOPLIST_KEY_*）
	     によって生成・マージされる。ここには追加分だけを書く。
	-->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.deskflowlabs.channeltimelineviewer.sharedlink</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>channeltimelineviewer</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
