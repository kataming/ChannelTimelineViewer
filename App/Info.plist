<dict>
	<!--
	  共有シート（Share Extension）からメインアプリを開くためのカスタムURLスキーム。
	  Share Extension は channeltimelineviewer://share?url=<共有されたYouTubeURL> を開くだけで、
	  URL の解析・API 取得・画面遷移はメインアプリ側で行う。
	  ※ その他の Info.plist の値は GENERATE_INFOPLIST_FILE=YES（project.yml の INFOPLIST_KEY_*）
	     によって生成・マージされる。ここには追加分だけを書く。
	-->
	<!--
	  輸出コンプライアンス: 独自の暗号化は実装しておらず、通信は OS 標準の HTTPS のみ。
	  そのため「非対象（exempt）」に当たる。これを入れておくと、アップロードのたびに
	  App Store Connect で輸出コンプライアンスを聞かれなくなる。
	-->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!--
	  Google AdMob（無料版の広告）。値は project.yml の ADMOB_* から入る。
	  - GADApplicationIdentifier: 無いと SDK が起動時に落ちるので、本番 ID が無いときはテスト用 ID が入る
	  - CTVAdMob*UnitID: 本番の広告ユニット。空ならリリースでも広告を一切出さない（Services/AdsConfig.swift）
	  デバッグビルドは常に Google 公式のテスト広告を使う。
	  ATT（NSUserTrackingUsageDescription）は入れていない＝IDFA は使わない。
	-->
	<key>GADApplicationIdentifier</key>
	<string>$(ADMOB_APP_ID)</string>
	<key>CTVAdMobBannerUnitID</key>
	<string>$(ADMOB_BANNER_UNIT_ID)</string>
	<key>CTVAdMobMRECUnitID</key>
	<string>$(ADMOB_MREC_UNIT_ID)</string>
	<key>CTVAdMobPlayerBannerUnitID</key>
	<string>$(ADMOB_PLAYER_BANNER_UNIT_ID)</string>
