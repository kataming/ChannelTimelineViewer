<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 一覧の取得（API）と、公式プレイヤーの表示に必要 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Firebase Analytics が既定で足してくる広告ID（AD_ID）の権限を**取り除く**。
         本アプリは広告識別子を使ったトラッキングを行わない、とプライバシーポリシーに
         書いてあるため（iOS 側の「IDFA 不使用」と揃える）。ここを外すと Play の
         「データセーフティ」でも広告IDの申告が不要になる。 -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ChannelTimelineViewer">

        <!-- 計測は「アプリの使われ方」だけに限る。広告向けの識別子・シグナルは集めない。 -->
        <meta-data
            android:name="google_analytics_adid_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="google_analytics_default_allow_ad_personalization_signals"
            android:value="false" />
        <!-- 端末の広告IDに紐づく「Google シグナル」も使わない。 -->
        <meta-data
            android:name="google_analytics_ssaid_collection_enabled"
            android:value="false" />

        <!-- configChanges: 画面の向きが変わっても Activity を作り直さない。
             作り直すと WebView が捨てられ、全画面にして横向きにした瞬間に再生が
             止まってしまう（Compose 側は向きの変化に自分で追随する）。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:theme="@style/Theme.ChannelTimelineViewer">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- YouTube アプリ / ブラウザの「共有」からURLを受け取る。
                 iOS と違い、Android は共有からアプリを直接開けるのでそのまま一覧を表示する。 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>
</manifest>
