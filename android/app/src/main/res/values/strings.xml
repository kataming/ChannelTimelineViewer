    <string name="app_name" translatable="false">Channel Timeline Viewer</string>
    <!-- 自動再生の説明 -->
    <string name="about_autoplay_body">Autoplay is off by default: playback stops when a video ends and a “Play next video” button appears. It continues only if you turn on “Autoplay next when the video ends” yourself on the player screen. Even then it moves only to the next video in the channel list you opened — never to related or recommended videos. There is no background playback, so closing the app stops both playback and autoplay.</string>
    <!-- 見出し: 自動再生 -->
    <string name="about_autoplay_header">Autoplay (optional, off by default)</string>
    <!-- データの説明 -->
    <string name="about_data_body">Video lists come from the YouTube Data API v3. Playback embeds YouTube’s official player as-is. No scraping and no custom player.</string>
    <!-- 見出し: データの取得と再生について -->
    <string name="about_data_header">How data and playback work</string>
