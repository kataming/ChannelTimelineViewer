---
// ストアのバッジ。外部画像を読み込まずに済むよう、ロゴは inline SVG で描いている。
// 文言は translations.js の store.* から取るので、7言語すべてで自然な表記になる。
import { APP_STORE_URL, PLAY_STORE_URL } from '../config.js';

const { copy } = Astro.props;
const hasAndroid = Boolean(PLAY_STORE_URL);
---

<div class="badges">
  <a class="badge badge-live" href={APP_STORE_URL} rel="noopener" aria-label={copy.store.iosAria}>
    <svg class="logo" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path
        fill="currentColor"
        d="M17.05 12.54c-.02-2.3 1.88-3.4 1.96-3.45-1.07-1.56-2.73-1.77-3.32-1.8-1.41-.14-2.76.83-3.47.83-.72 0-1.82-.81-3-.79-1.54.02-2.97.9-3.76 2.28-1.61 2.79-.41 6.92 1.16 9.18.77 1.11 1.68 2.35 2.88 2.31 1.16-.05 1.59-.75 2.99-.75 1.4 0 1.79.75 3.01.72 1.24-.02 2.03-1.13 2.79-2.24.88-1.29 1.24-2.54 1.26-2.6-.03-.01-2.44-.94-2.46-3.72zM14.78 5.39c.64-.77 1.07-1.85.95-2.92-.92.04-2.03.61-2.68 1.38-.59.68-1.1 1.78-.96 2.83 1.03.08 2.07-.52 2.69-1.29z"
      />
    </svg>
    <span class="lines">
      <span class="pre">{copy.store.iosPre}</span>
      <span class="name">{copy.store.iosName}</span>
    </span>
  </a>

  {hasAndroid ? (
    <a class="badge badge-live" href={PLAY_STORE_URL} rel="noopener">
      <svg class="logo" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path fill="#00c3ff" d="M3.9 1.8 13.8 11.7v.2L3.9 22.2c-.34-.3-.55-.8-.55-1.44V3.24c0-.64.21-1.14.55-1.44z" />
        <path fill="#ffce00" d="m17.2 15.3-3.4-3.4v-.2l3.4-3.4 4 2.3c1.14.65 1.14 1.72 0 2.37z" />
        <path fill="#ff3a44" d="m17.2 15.3-3.4-3.4L3.9 22.2c.42.44 1.05.47 1.75.07z" />
        <path fill="#00e676" d="M17.2 8.6 5.65 2.03c-.7-.4-1.33-.37-1.75.07l9.9 9.8z" />
      </svg>
      <span class="lines">
        <span class="pre">{copy.store.androidPre}</span>
        <span class="name">{copy.store.androidName}</span>
      </span>
    </a>
  ) : (
    <span class="badge badge-pending" aria-disabled="true" title={copy.store.androidNote}>
      <svg class="logo" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path fill="currentColor" opacity="0.55" d="M3.9 1.8 13.8 11.7v.2L3.9 22.2c-.34-.3-.55-.8-.55-1.44V3.24c0-.64.21-1.14.55-1.44z" />
        <path fill="currentColor" opacity="0.8" d="m17.2 15.3-3.4-3.4v-.2l3.4-3.4 4 2.3c1.14.65 1.14 1.72 0 2.37z" />
        <path fill="currentColor" opacity="0.65" d="m17.2 15.3-3.4-3.4L3.9 22.2c.42.44 1.05.47 1.75.07z" />
        <path fill="currentColor" opacity="0.9" d="M17.2 8.6 5.65 2.03c-.7-.4-1.33-.37-1.75.07l9.9 9.8z" />
      </svg>
      <span class="lines">
        <span class="pre">{copy.store.androidPre}</span>
        <span class="name">{copy.store.androidName}</span>
      </span>
      <span class="status">{copy.store.androidStatus}</span>
    </span>
  )}
</div>

<style>
  .badges { display: flex; gap: 14px; flex-wrap: wrap; align-items: center; }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 10px 20px 10px 16px;
    border-radius: 12px;
    text-decoration: none;
    border: 1px solid transparent;
    line-height: 1.15;
  }
  .badge-live {
    background: var(--text);
    color: var(--bg);
  }
  .badge-live:hover { opacity: 0.88; }
  .badge-pending {
    background: transparent;
    color: var(--muted);
    border-color: var(--line);
  }
  .logo { width: 26px; height: 26px; flex: none; }
  .lines { display: flex; flex-direction: column; }
  .pre { font-size: 0.7rem; letter-spacing: 0.02em; opacity: 0.85; }
  .name { font-size: 1.15rem; font-weight: 600; letter-spacing: -0.01em; }
  .status {
    font-size: 0.7rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 2px 9px;
    white-space: nowrap;
  }
</style>
