---
import Base from '../../layouts/Base.astro';
import StoreBadges from '../../components/StoreBadges.astro';
import ScreenGallery from '../../components/ScreenGallery.astro';
import TrialApp from '../../components/TrialApp.astro';
import { codes, langOf, t, path } from '../../i18n/index.js';
import { trialCopy } from '../../i18n/trial.js';

export function getStaticPaths() {
  return codes.map((code) => ({ params: { lang: langOf(code).slug }, props: { code } }));
}

const { code } = Astro.props;
const copy = t(code);
const trial = trialCopy(code);
const L = langOf(code);
---

<Base lang={code} page="" title={copy.meta.title} description={copy.meta.description}>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="badge">{copy.hero.badge}</p>
        <h1>
          {copy.hero.titleLines
            ? copy.hero.titleLines.map((line) => <span class="title-line">{line}</span>)
            : copy.hero.title}
        </h1>
        <p class="lede">{copy.hero.subtitle}</p>
        <div class="cta">
          <StoreBadges copy={copy} />
        </div>
        <p class="muted small">{copy.hero.ctaNote}</p>
        <p class="muted small">{copy.store.androidNote}</p>
      </div>
      {/* 静止画のスクリーンショットではなく、実際に動くWeb体験版をスマホの枠に入れて置く。
          中身は /try/ と同じもの（保存先も同じなので、ここで試した続きを /try/ で見られる）。 */}
      <div class="hero-demo">
        <TrialApp code={code} htmlLang={L.htmlLang} variant="phone" />
        <p class="demo-note">
          <a href={path(code, 'try')}>{trial.promo.cta}</a>
        </p>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2>{copy.problem.title}</h2>
      <p class="lede">{copy.problem.body}</p>
    </div>
  </section>

  <section id="try">
    <div class="wrap">
      <h2>{trial.promo.title}</h2>
      <p class="lede">{trial.promo.body}</p>
      <p><a class="btn" href={path(code, 'try')}>{trial.promo.cta}</a></p>
      <p class="muted small">{trial.limitLine}</p>
    </div>
  </section>

  <section id="screens">
    <div class="wrap">
      <h2>{copy.screensTitle}</h2>
      <p class="lede">{copy.screensLede}</p>
      <ScreenGallery lang={code} copy={copy} />
    </div>
  </section>

  <section id="features">
    <div class="wrap">
      <h2>{copy.featuresTitle}</h2>
      <div class="grid">
        {copy.features.map((f) => (
          <article class="card">
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="how">
    <div class="wrap">
      <h2>{copy.howTitle}</h2>
      <div class="grid steps">
        {copy.how.map((s) => (
          <article class="card">
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </article>
        ))}
      </div>
      <p class="more"><a href={path(code, 'manual')}>{copy.nav.manual}</a></p>
    </div>
  </section>

  <section id="pricing">
    <div class="wrap">
      <h2>{copy.pricing.title}</h2>
      <p class="lede">{copy.pricing.lede}</p>
      <div class="grid plans">
        <article class="card">
          <h3>{copy.pricing.freeTitle}</h3>
          <p>{copy.pricing.freeBody}</p>
        </article>
        <article class="card plan-pro">
          <h3>{copy.pricing.proTitle}</h3>
          <p>{copy.pricing.proBody}</p>
        </article>
      </div>
      <p class="muted small note">{copy.pricing.note}</p>
    </div>
  </section>

  <section id="notes">
    <div class="wrap">
      <h2>{copy.notesTitle}</h2>
      <ul class="plain">
        {copy.notes.map((n) => <li>{n}</li>)}
      </ul>
    </div>
  </section>

  <section id="faq">
    <div class="wrap">
      <h2>{copy.faqTitle}</h2>
      {copy.faq.map((item) => (
        <details>
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
      <p class="more">
        <a href={path(code, 'support')}>{copy.nav.support}</a>
        {' · '}
        <a href={path(code, 'privacy')}>{copy.nav.privacy}</a>
      </p>
    </div>
  </section>
</Base>

<style>
  /* スマホ全体が画面に収まるよう、上下の余白は詰めておく（下が切れないように）。 */
  .hero { padding: 16px 0 32px; }
  /* 見出しは指定した区切りでだけ改行する（単語の途中で割れないように）。 */
  .title-line { display: inline-block; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 48px; align-items: center; }
  .hero-demo { display: flex; flex-direction: column; align-items: center; gap: 8px; }
  .demo-note { margin: 0; font-size: 0.82rem; line-height: 1.4; }
  .demo-note a { color: var(--accent); font-weight: 700; }
  /* 狭い画面では、まずボタンまで見えることを優先して体験版は畳む
     （下の「PCでも1チャンネルを無料で試せます」から /try/ へ行ける）。 */
  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; gap: 0; }
    .hero-demo { display: none; }
  }
  .badge {
    display: inline-block;
    font-size: 0.8rem;
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 4px 12px;
    margin: 0 0 18px;
  }
  .cta { margin: 26px 0 12px; }
  .small { font-size: 0.85rem; margin-bottom: 4px; }
  .more { margin-top: 22px; font-size: 0.92rem; }
  .plans { grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
  .plan-pro { border-color: var(--accent); }
  .note { margin-top: 16px; }
</style>
