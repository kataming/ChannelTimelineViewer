---
import Base from '../../layouts/Base.astro';
import StoreBadges from '../../components/StoreBadges.astro';
import { codes, langOf, t, path } from '../../i18n/index.js';

export function getStaticPaths() {
  return codes.map((code) => ({ params: { lang: langOf(code).slug }, props: { code } }));
}

const { code } = Astro.props;
const copy = t(code);
---

<Base lang={code} page="" title={copy.meta.title} description={copy.meta.description}>
  <section class="hero">
    <div class="wrap">
      <p class="badge">{copy.hero.badge}</p>
      <h1>{copy.hero.title}</h1>
      <p class="lede">{copy.hero.subtitle}</p>
      <div class="cta">
        <StoreBadges copy={copy} />
      </div>
      <p class="muted small">{copy.hero.ctaNote}</p>
      <p class="muted small">{copy.store.androidNote}</p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2>{copy.problem.title}</h2>
      <p class="lede">{copy.problem.body}</p>
    </div>
  </section>

  <section id="features">
    <div class="wrap">
      <h2>{copy.featuresTitle}</h2>
      <div class="grid">
        {copy.features.map((f) => (
          <article class="card">
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="how">
    <div class="wrap">
      <h2>{copy.howTitle}</h2>
      <div class="grid steps">
        {copy.how.map((s) => (
          <article class="card">
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="pricing">
    <div class="wrap">
      <h2>{copy.pricing.title}</h2>
      <p class="lede">{copy.pricing.lede}</p>
      <div class="grid plans">
        <article class="card">
          <h3>{copy.pricing.freeTitle}</h3>
          <p>{copy.pricing.freeBody}</p>
        </article>
        <article class="card plan-pro">
          <h3>{copy.pricing.proTitle}</h3>
          <p>{copy.pricing.proBody}</p>
        </article>
      </div>
      <p class="muted small note">{copy.pricing.note}</p>
    </div>
  </section>

  <section id="notes">
    <div class="wrap">
      <h2>{copy.notesTitle}</h2>
      <ul class="plain">
        {copy.notes.map((n) => <li>{n}</li>)}
      </ul>
    </div>
  </section>

  <section id="faq">
    <div class="wrap">
      <h2>{copy.faqTitle}</h2>
      {copy.faq.map((item) => (
        <details>
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
      <p class="more">
        <a href={path(code, 'support')}>{copy.nav.support}</a>
        {' · '}
        <a href={path(code, 'privacy')}>{copy.nav.privacy}</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .hero { padding: 72px 0 56px; }
  .badge {
    display: inline-block;
    font-size: 0.8rem;
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 4px 12px;
    margin: 0 0 18px;
  }
  .cta { margin: 26px 0 12px; }
  .small { font-size: 0.85rem; margin-bottom: 4px; }
  .more { margin-top: 22px; font-size: 0.92rem; }
  .plans { grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
  .plan-pro { border-color: var(--accent); }
  .note { margin-top: 16px; }
</style>
