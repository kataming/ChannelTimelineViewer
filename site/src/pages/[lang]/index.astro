---
import Base from '../../layouts/Base.astro';
import StoreBadges from '../../components/StoreBadges.astro';
import ScreenGallery from '../../components/ScreenGallery.astro';
import { codes, langOf, t, path } from '../../i18n/index.js';
import { screensFor } from '../../i18n/screens.js';

export function getStaticPaths() {
  return codes.map((code) => ({ params: { lang: langOf(code).slug }, props: { code } }));
}

const { code } = Astro.props;
const copy = t(code);
// hero に置く1枚は「動画一覧＋進捗」（shots[1]）。このアプリが何をするか一番よく分かる画面。
// 撮れていなければ、その言語で用意できた最初の1枚を使う。
const shots = screensFor(code);
const hero = shots.find((s) => s.index === 1) || shots[0];
---

<Base lang={code} page="" title={copy.meta.title} description={copy.meta.description}>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="badge">{copy.hero.badge}</p>
        <h1>
          {copy.hero.titleLines
            ? copy.hero.titleLines.map((line) => <span class="title-line">{line}</span>)
            : copy.hero.title}
        </h1>
        <p class="lede">{copy.hero.subtitle}</p>
        <div class="cta">
          <StoreBadges copy={copy} />
        </div>
        <p class="muted small">{copy.hero.ctaNote}</p>
        <p class="muted small">{copy.store.androidNote}</p>
      </div>
      <div class="hero-shot">
        <img src={hero.src} width="440" height="956" alt={copy.shots[hero.index].title} decoding="async" />
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2>{copy.problem.title}</h2>
      <p class="lede">{copy.problem.body}</p>
    </div>
  </section>

  <section id="screens">
    <div class="wrap">
      <h2>{copy.screensTitle}</h2>
      <p class="lede">{copy.screensLede}</p>
      <ScreenGallery lang={code} copy={copy} />
    </div>
  </section>

  <section id="features">
    <div class="wrap">
      <h2>{copy.featuresTitle}</h2>
      <div class="grid">
        {copy.features.map((f) => (
          <article class="card">
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="how">
    <div class="wrap">
      <h2>{copy.howTitle}</h2>
      <div class="grid steps">
        {copy.how.map((s) => (
          <article class="card">
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </article>
        ))}
      </div>
      <p class="more"><a href={path(code, 'manual')}>{copy.nav.manual}</a></p>
    </div>
  </section>

  <section id="pricing">
    <div class="wrap">
      <h2>{copy.pricing.title}</h2>
      <p class="lede">{copy.pricing.lede}</p>
      <div class="grid plans">
        <article class="card">
          <h3>{copy.pricing.freeTitle}</h3>
          <p>{copy.pricing.freeBody}</p>
        </article>
        <article class="card plan-pro">
          <h3>{copy.pricing.proTitle}</h3>
          <p>{copy.pricing.proBody}</p>
        </article>
      </div>
      <p class="muted small note">{copy.pricing.note}</p>
    </div>
  </section>

  <section id="notes">
    <div class="wrap">
      <h2>{copy.notesTitle}</h2>
      <ul class="plain">
        {copy.notes.map((n) => <li>{n}</li>)}
      </ul>
    </div>
  </section>

  <section id="faq">
    <div class="wrap">
      <h2>{copy.faqTitle}</h2>
      {copy.faq.map((item) => (
        <details>
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
      <p class="more">
        <a href={path(code, 'support')}>{copy.nav.support}</a>
        {' · '}
        <a href={path(code, 'privacy')}>{copy.nav.privacy}</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .hero { padding: 72px 0 56px; }
  /* 見出しは指定した区切りでだけ改行する（単語の途中で割れないように）。 */
  .title-line { display: inline-block; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) 264px; gap: 56px; align-items: center; }
  .hero-shot img {
    width: 100%;
    height: auto;
    display: block;
    border: 1px solid var(--line);
    border-radius: 26px;
    box-shadow: 0 18px 44px rgba(0, 0, 0, 0.22);
  }
  /* 狭い画面では、まずボタンまで見えることを優先して1枚絵は畳む（下の一覧で全部見える）。 */
  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; gap: 0; }
    .hero-shot { display: none; }
  }
  .badge {
    display: inline-block;
    font-size: 0.8rem;
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 4px 12px;
    margin: 0 0 18px;
  }
  .cta { margin: 26px 0 12px; }
  .small { font-size: 0.85rem; margin-bottom: 4px; }
  .more { margin-top: 22px; font-size: 0.92rem; }
  .plans { grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
  .plan-pro { border-color: var(--accent); }
  .note { margin-top: 16px; }
</style>
