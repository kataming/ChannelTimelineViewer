---
// Web体験版（1チャンネル無料）。
//
// このページは「読み物」と「実際に動くもの」の両方を兼ねる:
//  - 静的HTML部分（見出し・説明・注意事項・FAQ・ストア導線）は7言語で出力され、検索にも載る
//  - 体験版そのものは TrialApp.astro（トップのヒーローと同じ中身）
//
// 位置づけは公式サイト上の**無料体験版**。複数チャンネルの保存は提供せず、
// iPhone / Android アプリのPro機能として案内する（スマホ版の価値を壊さないため）。
import Base from '../../layouts/Base.astro';
import StoreBadges from '../../components/StoreBadges.astro';
import TrialApp from '../../components/TrialApp.astro';
import { codes, langOf, t, path } from '../../i18n/index.js';
import { trialCopy } from '../../i18n/trial.js';

export function getStaticPaths() {
  return codes.map((code) => ({ params: { lang: langOf(code).slug }, props: { code } }));
}

const { code } = Astro.props;
const copy = t(code);
const trial = trialCopy(code);
const L = langOf(code);
---

<Base lang={code} page="try" title={trial.meta.title} description={trial.meta.description}>
  <section class="hero">
    <div class="wrap">
      <p class="badge">{trial.hero.badge}</p>
      <h1>{trial.hero.title}</h1>
      <p class="lede">{trial.hero.lede}</p>
      <p class="muted small">{trial.hero.note}</p>
      <div class="cta"><StoreBadges copy={copy} /></div>
      <p class="muted small">{trial.limitLine}</p>
    </div>
  </section>

  <section id="app">
    <div class="wrap">
      <TrialApp code={code} htmlLang={L.htmlLang} variant="full" />
    </div>
  </section>

  <section id="app-cta">
    <div class="wrap">
      <h2>{copy.pricing.title}</h2>
      <p class="lede">{trial.appLine}</p>
      <div class="grid plans">
        <article class="card">
          <h3>{copy.pricing.freeTitle}</h3>
          <p>{copy.pricing.freeBody}</p>
        </article>
        <article class="card plan-pro">
          <h3>{copy.pricing.proTitle}</h3>
          <p>{copy.pricing.proBody}</p>
        </article>
      </div>
      <div class="cta"><StoreBadges copy={copy} /></div>
      <p class="muted small">{copy.pricing.note}</p>
    </div>
  </section>

  <section id="notes">
    <div class="wrap">
      <h2>{trial.notesTitle}</h2>
      <ul class="plain">
        {trial.notes.map((n) => <li>{n}</li>)}
      </ul>
    </div>
  </section>

  <section id="faq">
    <div class="wrap">
      <h2>{trial.faqTitle}</h2>
      {trial.faq.map((item) => (
        <details>
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
      <p class="more">
        <a href={path(code, '')}>{copy.nav.features}</a>
        {' · '}
        <a href={path(code, 'manual')}>{copy.nav.manual}</a>
        {' · '}
        <a href={path(code, 'support')}>{copy.nav.support}</a>
        {' · '}
        <a href={path(code, 'privacy')}>{copy.nav.privacy}</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .hero { padding: 64px 0 40px; }
  .badge {
    display: inline-block;
    font-size: 0.8rem;
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 4px 12px;
    margin: 0 0 18px;
  }
  .cta { margin: 22px 0 12px; }
  .small { font-size: 0.85rem; margin-bottom: 4px; }
  .more { margin-top: 22px; font-size: 0.92rem; }
  .plans { grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
  .plan-pro { border-color: var(--accent); }
</style>
