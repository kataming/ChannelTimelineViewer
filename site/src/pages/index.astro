---
// ルート（/）は言語別ページへの入口。ブラウザの言語で振り分け、
// JavaScript が無い場合や未対応言語のときは英語版へ送る。
// 振り分けの処理は LangRedirect.astro（/watch-queue/ と共通）。
import { languages, path, DEFAULT_CODE } from '../i18n/index.js';
import { SITE_URL, PEERPUSH_URL, FAZIER_URL, FAZIER_BADGE_SRC, STARTUPBASE_URL, STARTUPBASE_BADGE_SRC } from '../config.js';
import LangRedirect from '../components/LangRedirect.astro';

const fallback = path(DEFAULT_CODE);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Channel Timeline Viewer</title>
    <link rel="canonical" href={SITE_URL + fallback} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta http-equiv="refresh" content={`0; url=${fallback}`} />
    {languages.map((l) => (
      <link rel="alternate" hreflang={l.htmlLang} href={SITE_URL + path(l.code)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={SITE_URL + fallback} />
    <LangRedirect />
  </head>
  <body>
    <p style="font-family: system-ui; padding: 24px;">
      <a href={fallback}>Channel Timeline Viewer</a>
    </p>
    <ul style="font-family: system-ui; padding: 0 24px;">
      {languages.map((l) => (
        <li><a href={path(l.code)} hreflang={l.htmlLang}>{l.label}</a></li>
      ))}
    </ul>
    <!--
      このページは言語別ページへ振り分けるだけだが、外部サービス（PeerPush など）の確認は
      **ルート（/）を読みに来る**。各言語ページのフッターだけでは見つけてもらえないので、
      ここにも同じリンクを1つ置く。隠さない・普通のリンクにすること。
    -->
    <p style="font-family: system-ui; padding: 0 24px 24px;">
      <a href={PEERPUSH_URL} target="_blank" rel="noopener noreferrer">Listed on PeerPush</a>
    </p>
    <p style="padding: 0 24px 24px;">
      <a href={FAZIER_URL} target="_blank" rel="noopener"><img src={FAZIER_BADGE_SRC} width="120" alt="Fazier badge" /></a>
      <a href={STARTUPBASE_URL} target="_blank" rel="noopener noreferrer"><img src={STARTUPBASE_BADGE_SRC} alt="Launched on StartupBase" height="55" style="height:55px;width:auto;" /></a>
    </p>
  </body>
</html>
