{
  "name": "watch-queue-sync",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Watch Queue V2 sync API (Cloudflare Worker + D1). Pairing, queue sync, entitlement and the V2 feature flag.",
  "scripts": {
    "test": "vitest run",
    "test:integration": "node test/integration.mjs",
    "dev": "wrangler dev --persist-to .wrangler/state",
    "migrate:local": "wrangler d1 migrations apply watch_queue_sync --local --persist-to .wrangler/state",
    "migrate:remote": "wrangler d1 migrations apply watch_queue_sync --remote",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "vitest": "^5.0.0",
    "wrangler": "^4.42.0"
  }
}
